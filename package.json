{
  "name": "momentum-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Momentum Dashboard — a Manifest V3 Chrome new-tab extension built with Next.js, TypeScript, Redux Toolkit and Tailwind CSS.",
  "author": "Vivek Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Slv-WebTech/chrome-extension.git"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "next dev --turbopack -p 5000",
    "build": "pnpm build:extension",
    "build:extension": "next build && node scripts/postbuild-extension.mjs",
    "build:web": "cross-env BUILD_TARGET=web next build",
    "validate": "node scripts/validate-extension.mjs",
    "package": "pnpm build:extension && node scripts/package-extension.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@reduxjs/toolkit": "^2.11.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.38.0",
    "geist": "^1.5.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "^9.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.0",
    "fflate": "^0.8.2",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.8",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
