{
  "manifest_version": 3,
  "name": "Daily Boost - Motivation & Weather",
  "version": "1.0.0",
  "description": "Get daily motivation quotes and weather updates to boost your productivity!",
  "permissions": ["storage", "geolocation"],
  "host_permissions": ["https://api.openweathermap.org/*", "https://api.quotable.io/*"],
  "action": {
    "default_popup": "index.html",
    "default_title": "Daily Boost",
    "default_icon": {
      "16": "logo192.png",
      "32": "logo192.png",
      "48": "logo192.png",
      "128": "logo192.png"
    }
  },
  "icons": {
    "16": "logo192.png",
    "32": "logo192.png",
    "48": "logo192.png",
    "128": "logo192.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
